# SKOS/RDF projection of the semantic registry.
#
# DERIVED ARTIFACT — do not edit. The source of truth is the YAML
# under registry/ (DR-0078). Regenerate with registry/compile.py.
# Mapping and its documented export losses: SPEC-0005.
# Registry version: 0.1.2

@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix uiw: <https://ukraineindependencewar.org/ns/registry#> .

uiw:uiw-semantic-registry
    a skos:ConceptScheme ;
    skos:prefLabel "Ukraine's Second War of Independence — Semantic Registry"@en ;
    uiw:version "0.1.2" ;
    uiw:status "effective" ;
    dcterms:issued "2026-08-16" .

uiw:absence-states
    a skos:ConceptScheme ;
    skos:prefLabel "absence state"@en ;
    skos:definition "Typed states expressing why a value is absent. A missing value never silently means \"no\" (record §41, Principle 8)."@en ;
    skos:scopeNote "This vocabulary will be exercised heavily in the export-control domain, where licensing data is rarely public (DR-0042)."@en ;
    skos:note "Schema rejects null wherever an absence state is required. Explicit negative assertions (\"X did not occur\", \"no license was issued\") are assertions like any other: attributed, dated, evidence-backed."@en ;
    uiw:status "effective" ;
    uiw:effective "2026-08-16" ;
    uiw:closed "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
    uiw:steward "founder" ;
    uiw:layer "epistemic" ;
    uiw:type "vocabulary" ;
    uiw:authorised_by "DR-0029" ;
    uiw:satisfies_requirements "EVID-010", "LEGAL-008" ;
    uiw:depends_on_specs "SPEC-0001" .

uiw:absence-states--unknown
    a skos:Concept ;
    skos:inScheme uiw:absence-states ;
    skos:topConceptOf uiw:absence-states ;
    skos:prefLabel "unknown"@en ;
    skos:definition "The value is not known to the project and its knowability is not characterised."@en .

uiw:absence-states--not-researched
    a skos:Concept ;
    skos:inScheme uiw:absence-states ;
    skos:topConceptOf uiw:absence-states ;
    skos:prefLabel "not researched"@en ;
    skos:definition "No research has been attempted. Distinct from having looked and found nothing."@en .

uiw:absence-states--no-evidence-found
    a skos:Concept ;
    skos:inScheme uiw:absence-states ;
    skos:topConceptOf uiw:absence-states ;
    skos:prefLabel "no evidence found"@en ;
    skos:definition "Research was attempted and found insufficient evidence. Records the scope and method of the search where consequential (§76)."@en ;
    skos:scopeNote "Not: Not proof of non-occurrence. \"We searched and found insufficient evidence\" is not \"we proved it did not happen\" (§76)."@en .

uiw:absence-states--unavailable
    a skos:Concept ;
    skos:inScheme uiw:absence-states ;
    skos:topConceptOf uiw:absence-states ;
    skos:prefLabel "unavailable"@en ;
    skos:definition "The value exists somewhere but the project cannot obtain it."@en .

uiw:absence-states--withheld
    a skos:Concept ;
    skos:inScheme uiw:absence-states ;
    skos:topConceptOf uiw:absence-states ;
    skos:prefLabel "withheld"@en ;
    skos:definition "The value is known to the project but deliberately not exposed at this access tier — for source protection, legal, or privacy reasons."@en .

uiw:absence-states--redacted
    a skos:Concept ;
    skos:inScheme uiw:absence-states ;
    skos:topConceptOf uiw:absence-states ;
    skos:prefLabel "redacted"@en ;
    skos:definition "The value was removed under governed redaction (DR-0077), leaving a tombstone recording the fact, date, authority, and grounds."@en .

uiw:absence-states--lost-or-destroyed
    a skos:Concept ;
    skos:inScheme uiw:absence-states ;
    skos:topConceptOf uiw:absence-states ;
    skos:prefLabel "lost or destroyed"@en ;
    skos:definition "The value existed and is established to be irrecoverable."@en .

uiw:absence-states--not-applicable
    a skos:Concept ;
    skos:inScheme uiw:absence-states ;
    skos:topConceptOf uiw:absence-states ;
    skos:prefLabel "not applicable"@en ;
    skos:definition "The field has no meaning for this subject."@en .

uiw:absence-states--indeterminate
    a skos:Concept ;
    skos:inScheme uiw:absence-states ;
    skos:topConceptOf uiw:absence-states ;
    skos:prefLabel "indeterminate"@en ;
    skos:definition "The value is genuinely indeterminate rather than merely unknown — the question has no determinate answer."@en .

uiw:access-tiers
    a skos:ConceptScheme ;
    skos:prefLabel "access tier"@en ;
    skos:definition "The publication/access tier at which an object or assertion is available (record §12)."@en ;
    skos:scopeNote "Access tiers never create competing versions of historical truth: all tiers read the same canonical assertions, and tier affects visibility only, never values (§4, ARCH-006). Restricted material must be inaccessible below its tier in the canonical store, every projection, the search index, and published surfaces (SEC-004)."@en ;
    skos:note "**One of four independent dimensions**, never collapsed: access tier, sensitivity, rights (see rights-permissions), and evidentiary disclosure. There is no universal `is_public` flag (§12, SEC-003)."@en ;
    skos:scopeNote "Not: Not source accessibility (§27) — whether a *source in the world* is public, paywalled, deleted, or archived is a different vocabulary and never shares a field. Conflict register C-16."@en ;
    uiw:status "effective" ;
    uiw:effective "2026-08-16" ;
    uiw:closed "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
    uiw:steward "founder" ;
    uiw:layer "governance" ;
    uiw:type "vocabulary" ;
    uiw:authorised_by "DR-0067", "DR-0072" ;
    uiw:satisfies_requirements "SEC-003", "SEC-004", "ARCH-006", "PRES-012" ;
    uiw:depends_on_specs "SPEC-0003" .

uiw:access-tiers--public
    a skos:Concept ;
    skos:inScheme uiw:access-tiers ;
    skos:topConceptOf uiw:access-tiers ;
    skos:prefLabel "public"@en ;
    skos:definition "Openly available. The public historical archive remains meaningfully open (§4)."@en .

uiw:access-tiers--subscriber
    a skos:Concept ;
    skos:inScheme uiw:access-tiers ;
    skos:topConceptOf uiw:access-tiers ;
    skos:prefLabel "subscriber"@en ;
    skos:definition "Available to subscribers of professional datasets and tools (§4)."@en .

uiw:access-tiers--internal
    a skos:Concept ;
    skos:inScheme uiw:access-tiers ;
    skos:topConceptOf uiw:access-tiers ;
    skos:prefLabel "internal"@en ;
    skos:definition "Available to the project team only."@en .

uiw:access-tiers--confidential
    a skos:Concept ;
    skos:inScheme uiw:access-tiers ;
    skos:topConceptOf uiw:access-tiers ;
    skos:prefLabel "confidential"@en ;
    skos:definition "Restricted beyond internal — including confidential source identity, which additionally lives in a separable store (SEC-001, DR-0059)."@en .

uiw:access-tiers--researcher-restricted
    a skos:Concept ;
    skos:inScheme uiw:access-tiers ;
    skos:topConceptOf uiw:access-tiers ;
    skos:prefLabel "researcher restricted"@en ;
    skos:definition "Available to named external researchers under agreed terms."@en .

uiw:access-tiers--investigator-restricted
    a skos:Concept ;
    skos:inScheme uiw:access-tiers ;
    skos:topConceptOf uiw:access-tiers ;
    skos:prefLabel "investigator restricted"@en ;
    skos:definition "Available to named investigative or prosecutorial bodies under agreed terms."@en .

uiw:access-tiers--private-preservation
    a skos:Concept ;
    skos:inScheme uiw:access-tiers ;
    skos:topConceptOf uiw:access-tiers ;
    skos:prefLabel "private preservation"@en ;
    skos:definition "Preserved but not disclosed at any tier — material the archive may hold but not expose (Principle 11, §14)."@en .

uiw:analytic-confidence
    a skos:ConceptScheme ;
    skos:prefLabel "analytic confidence"@en ;
    skos:definition "The strength of an analytic judgment, derived from stated evidence quality, corroboration weighted by independence (DR-0028), and reasoning strength. The second of the two uncertainty dimensions, never collapsed into the first."@en ;
    skos:scopeNote "Confidence is about the judgment; likelihood is about the proposition. A high-confidence judgment that something is very unlikely is coherent and common."@en ;
    skos:note "Bare numeric confidence scores are prohibited (DR-0026). Confidence is derived from stated grounds — an assessment must be able to say why its confidence is what it is."@en ;
    skos:scopeNote "Not: Not likelihood (see likelihood-bands). Not a statistical confidence interval. Conflict register C-18."@en ;
    uiw:closeMatchTarget "ICD 203 confidence levels" ;
    uiw:closeMatchTarget "IPCC confidence scale (evidence × agreement)" ;
    uiw:status "effective" ;
    uiw:effective "2026-08-16" ;
    uiw:closed "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
    uiw:steward "founder" ;
    uiw:layer "epistemic" ;
    uiw:type "vocabulary" ;
    uiw:authorised_by "DR-0026" ;
    uiw:satisfies_requirements "EVID-006" .

uiw:analytic-confidence--low
    a skos:Concept ;
    skos:inScheme uiw:analytic-confidence ;
    skos:topConceptOf uiw:analytic-confidence ;
    skos:prefLabel "low confidence"@en ;
    skos:definition "Evidence is sparse, of uncertain quality, or drawn from dependent lines; or the reasoning relies on unverified assumptions."@en .

uiw:analytic-confidence--moderate
    a skos:Concept ;
    skos:inScheme uiw:analytic-confidence ;
    skos:topConceptOf uiw:analytic-confidence ;
    skos:prefLabel "moderate confidence"@en ;
    skos:definition "Evidence is adequate and partly corroborated by independent lines; some gaps or unresolved defeaters remain."@en .

uiw:analytic-confidence--high
    a skos:Concept ;
    skos:inScheme uiw:analytic-confidence ;
    skos:topConceptOf uiw:analytic-confidence ;
    skos:prefLabel "high confidence"@en ;
    skos:definition "Evidence is strong and corroborated across independent lines; raised defeaters have been addressed; reasoning is explicit and reviewed."@en .

uiw:classification-systems
    a skos:ConceptScheme ;
    skos:prefLabel "classification system"@en ;
    skos:definition "The regulatory classification systems under which a product may be classified (record §66)."@en ;
    skos:scopeNote "A product's classification is contextual, not intrinsic: the same good may classify differently by jurisdiction and over time."@en ;
    skos:note "**Open vocabulary** — national export-control regimes vary and more will be encountered; additions by registry process (DR-0080). Every classification assertion records its system, jurisdiction, asserting authority, and validity period, and is typed as official, declared, or project-analytical (§66). Classifications attach to **product types** (DR-0014), and to individual items only where evidence individuates."@en ;
    uiw:status "effective" ;
    uiw:effective "2026-08-16" ;
    uiw:closed "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
    uiw:steward "founder" ;
    uiw:layer "legal" ;
    uiw:type "vocabulary" ;
    uiw:authorised_by "DR-0042" ;
    uiw:satisfies_requirements "LEGAL-005" .

uiw:classification-systems--hs
    a skos:Concept ;
    skos:inScheme uiw:classification-systems ;
    skos:topConceptOf uiw:classification-systems ;
    skos:prefLabel "Harmonized System (HS)"@en ;
    skos:definition "WCO tariff nomenclature used in customs declarations."@en .

uiw:classification-systems--cn
    a skos:Concept ;
    skos:inScheme uiw:classification-systems ;
    skos:topConceptOf uiw:classification-systems ;
    skos:prefLabel "Combined Nomenclature (CN)"@en ;
    skos:definition "EU tariff nomenclature extending HS."@en .

uiw:classification-systems--eccn
    a skos:Concept ;
    skos:inScheme uiw:classification-systems ;
    skos:topConceptOf uiw:classification-systems ;
    skos:prefLabel "ECCN"@en ;
    skos:definition "US Export Control Classification Number under the EAR."@en .

uiw:classification-systems--eu-dual-use
    a skos:Concept ;
    skos:inScheme uiw:classification-systems ;
    skos:topConceptOf uiw:classification-systems ;
    skos:prefLabel "EU dual-use classification"@en ;
    skos:definition "Classification under EU Regulation 2021/821 annexes."@en .

uiw:classification-systems--wassenaar
    a skos:Concept ;
    skos:inScheme uiw:classification-systems ;
    skos:topConceptOf uiw:classification-systems ;
    skos:prefLabel "Wassenaar control list"@en ;
    skos:definition "Multilateral control-list classification upstream of national regimes."@en .

uiw:classification-systems--common-high-priority-list
    a skos:Concept ;
    skos:inScheme uiw:classification-systems ;
    skos:topConceptOf uiw:classification-systems ;
    skos:prefLabel "Common High Priority List"@en ;
    skos:definition "The coordinated list of battlefield-relevant goods used in export-control enforcement against Russian procurement."@en .

uiw:classification-systems--national-export-control
    a skos:Concept ;
    skos:inScheme uiw:classification-systems ;
    skos:topConceptOf uiw:classification-systems ;
    skos:prefLabel "national export-control classification"@en ;
    skos:definition "A national regime's classification not covered by a more specific member; the jurisdiction is recorded on the assertion."@en .

uiw:completeness-states
    a skos:ConceptScheme ;
    skos:prefLabel "completeness state"@en ;
    skos:definition "What the archive actually possesses of a documentary item, carried on the holding (record §26)."@en ;
    skos:note "Never imply possession of a full document when only a partial representation survives (§26). A fragment carries its locus within the whole. External custodians' copies are holdings with a non-project custodian and no representation link."@en ;
    skos:scopeNote "Not: A holdings fragment (partial possession) is not a fragment selector (annotation locus syntax). Conflict register C-14."@en ;
    uiw:status "effective" ;
    uiw:effective "2026-08-16" ;
    uiw:closed "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
    uiw:steward "founder" ;
    uiw:layer "documentary" ;
    uiw:type "vocabulary" ;
    uiw:authorised_by "DR-0061" ;
    uiw:satisfies_requirements "PRES-004" ;
    uiw:depends_on_specs "SPEC-0001" .

uiw:completeness-states--original
    a skos:Concept ;
    skos:inScheme uiw:completeness-states ;
    skos:topConceptOf uiw:completeness-states ;
    skos:prefLabel "original"@en ;
    skos:definition "The original object as acquired."@en ;
    skos:scopeNote "The earliest copy held by the project is not necessarily *the* original (§38); this records what the archive holds, not a provenance claim."@en .

uiw:completeness-states--archival-copy
    a skos:Concept ;
    skos:inScheme uiw:completeness-states ;
    skos:topConceptOf uiw:completeness-states ;
    skos:prefLabel "archival copy"@en ;
    skos:definition "A complete copy acquired from an archive or intermediary custodian."@en .

uiw:completeness-states--derivative
    a skos:Concept ;
    skos:inScheme uiw:completeness-states ;
    skos:topConceptOf uiw:completeness-states ;
    skos:prefLabel "derivative"@en ;
    skos:definition "A processed form — normalized, transcoded, or otherwise derived."@en .

uiw:completeness-states--screenshot
    a skos:Concept ;
    skos:inScheme uiw:completeness-states ;
    skos:topConceptOf uiw:completeness-states ;
    skos:prefLabel "screenshot"@en ;
    skos:definition "A rendered capture of appearance, not the underlying object."@en .

uiw:completeness-states--transcript
    a skos:Concept ;
    skos:inScheme uiw:completeness-states ;
    skos:topConceptOf uiw:completeness-states ;
    skos:prefLabel "transcript"@en ;
    skos:definition "A textual rendering of spoken or handwritten content."@en .

uiw:completeness-states--fragment
    a skos:Concept ;
    skos:inScheme uiw:completeness-states ;
    skos:topConceptOf uiw:completeness-states ;
    skos:prefLabel "fragment"@en ;
    skos:definition "A partial representation, carrying its locus within the whole."@en .

uiw:completeness-states--metadata-only
    a skos:Concept ;
    skos:inScheme uiw:completeness-states ;
    skos:topConceptOf uiw:completeness-states ;
    skos:prefLabel "metadata only"@en ;
    skos:definition "A descriptive record with no content held — by rights, sensitivity, or volume decision (DR-0068)."@en .

uiw:defeater-types
    a skos:ConceptScheme ;
    skos:prefLabel "defeater type"@en ;
    skos:definition "The three ways an argument can be attacked, from the structured argumentation tradition (ASPIC+/ABA)."@en ;
    skos:scopeNote "The distinction is load-bearing for evidence work: a forged document and a challenged interpretation of an authentic document are different attacks requiring different answers (§38)."@en ;
    skos:note "An attacked argument with no resolution remains **visibly contested**; \"unresolved\" is a legitimate end-state (record §40). No computation adjudicates the outcome (DR-0036)."@en ;
    skos:scopeNote "Not: \"Attack\" here is an argumentation-theoretic conflict relation, never a military attack — those live in the world layer. Always layer-qualified. Conflict register C-24."@en ;
    uiw:status "effective" ;
    uiw:effective "2026-08-16" ;
    uiw:closed "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
    uiw:steward "founder" ;
    uiw:layer "argument" ;
    uiw:type "vocabulary" ;
    uiw:authorised_by "DR-0033" ;
    uiw:satisfies_requirements "EVID-012" ;
    uiw:depends_on_specs "SPEC-0001" .

uiw:defeater-types--rebutting
    a skos:Concept ;
    skos:inScheme uiw:defeater-types ;
    skos:topConceptOf uiw:defeater-types ;
    skos:prefLabel "rebutting"@en ;
    skos:definition "Attacks the conclusion itself — counter-evidence for the opposite."@en .

uiw:defeater-types--undercutting
    a skos:Concept ;
    skos:inScheme uiw:defeater-types ;
    skos:topConceptOf uiw:defeater-types ;
    skos:prefLabel "undercutting"@en ;
    skos:definition "Attacks the inference link, leaving the premises intact — e.g. the document is authentic but does not show what is claimed. A dependence relation (DR-0028) undercuts a corroboration argument."@en .

uiw:defeater-types--undermining
    a skos:Concept ;
    skos:inScheme uiw:defeater-types ;
    skos:topConceptOf uiw:defeater-types ;
    skos:prefLabel "undermining"@en ;
    skos:definition "Attacks a premise — e.g. the document is forged, or the witness was not present. Authenticity challenges under §38 enter here."@en .

uiw:dependence-relation-types
    a skos:ConceptScheme ;
    skos:prefLabel "dependence relation"@en ;
    skos:definition "Typed relations recording how one source depends on another, so that corroboration counts independent lines only (record §36)."@en ;
    skos:scopeNote "Five publications repeating one original report are not five independent confirmations (§36). A dependence relation *undercuts* a corroboration argument (DR-0033)."@en ;
    skos:note "Independence is a **researched conclusion** — the established absence of dependence — never a default assumption. Known relationships may be declared at source-registry level (DR-0067) and inherited as a dependence hypothesis by every item, rather than rediscovered per article."@en ;
    uiw:status "effective" ;
    uiw:effective "2026-08-16" ;
    uiw:closed "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
    uiw:steward "founder" ;
    uiw:layer "epistemic" ;
    uiw:type "vocabulary" ;
    uiw:authorised_by "DR-0028" ;
    uiw:satisfies_requirements "EVID-009" ;
    uiw:depends_on_specs "SPEC-0003" .

uiw:dependence-relation-types--cites
    a skos:Concept ;
    skos:inScheme uiw:dependence-relation-types ;
    skos:topConceptOf uiw:dependence-relation-types ;
    skos:prefLabel "cites"@en ;
    skos:definition "The source explicitly references the other as its basis."@en .

uiw:dependence-relation-types--reposts
    a skos:Concept ;
    skos:inScheme uiw:dependence-relation-types ;
    skos:topConceptOf uiw:dependence-relation-types ;
    skos:prefLabel "reposts"@en ;
    skos:definition "The source reproduces the other's content, with or without attribution."@en .

uiw:dependence-relation-types--syndicates
    a skos:Concept ;
    skos:inScheme uiw:dependence-relation-types ;
    skos:topConceptOf uiw:dependence-relation-types ;
    skos:prefLabel "syndicates"@en ;
    skos:definition "The source republishes under a distribution arrangement."@en .

uiw:dependence-relation-types--derives-from
    a skos:Concept ;
    skos:inScheme uiw:dependence-relation-types ;
    skos:topConceptOf uiw:dependence-relation-types ;
    skos:prefLabel "derives from"@en ;
    skos:definition "The source's content is materially derived from the other without being a reproduction."@en .

uiw:dependence-relation-types--shares-underlying-document
    a skos:Concept ;
    skos:inScheme uiw:dependence-relation-types ;
    skos:topConceptOf uiw:dependence-relation-types ;
    skos:prefLabel "shares underlying document"@en ;
    skos:definition "Both rest on the same document; their agreement is not independent."@en .

uiw:dependence-relation-types--shares-underlying-witness
    a skos:Concept ;
    skos:inScheme uiw:dependence-relation-types ;
    skos:topConceptOf uiw:dependence-relation-types ;
    skos:prefLabel "shares underlying witness"@en ;
    skos:definition "Both rest on the same testimony; their agreement is not independent."@en .

uiw:dependence-relation-types--common-evidentiary-origin
    a skos:Concept ;
    skos:inScheme uiw:dependence-relation-types ;
    skos:topConceptOf uiw:dependence-relation-types ;
    skos:prefLabel "common evidentiary origin"@en ;
    skos:definition "Both trace to a common origin not captured by the more specific types — e.g. a shared briefing, dataset, or intermediary."@en .

uiw:document-statuses
    a skos:ConceptScheme ;
    skos:prefLabel "document status"@en ;
    skos:definition "The lifecycle status of a controlled governance document (REQ, POL, PROC, DR, SPEC, METH) under record §100's document classes."@en ;
    skos:note "**Status is explicit document metadata, never inferred from Git state** — a commit is not an approval (DR-0046). Superseded documents remain in place, marked, with supersession links in both directions (§77)."@en ;
    skos:scopeNote "Not: Not epistemic status (see epistemic-categories, likelihood-bands) and not legal status. Always class-qualified. Conflict register C-39."@en ;
    uiw:status "effective" ;
    uiw:effective "2026-08-16" ;
    uiw:closed "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
    uiw:steward "founder" ;
    uiw:layer "governance" ;
    uiw:type "vocabulary" ;
    uiw:authorised_by "DR-0046" ;
    uiw:satisfies_requirements "EDIT-001", "EDIT-002" .

uiw:document-statuses--draft
    a skos:Concept ;
    skos:inScheme uiw:document-statuses ;
    skos:topConceptOf uiw:document-statuses ;
    skos:prefLabel "draft"@en ;
    skos:definition "Being written; carries no authority."@en .

uiw:document-statuses--proposed
    a skos:Concept ;
    skos:inScheme uiw:document-statuses ;
    skos:topConceptOf uiw:document-statuses ;
    skos:prefLabel "proposed"@en ;
    skos:definition "Submitted for the founder's decision; carries no authority."@en .

uiw:document-statuses--approved
    a skos:Concept ;
    skos:inScheme uiw:document-statuses ;
    skos:topConceptOf uiw:document-statuses ;
    skos:prefLabel "approved"@en ;
    skos:definition "Decided by the founder/principal editor."@en .

uiw:document-statuses--effective
    a skos:Concept ;
    skos:inScheme uiw:document-statuses ;
    skos:topConceptOf uiw:document-statuses ;
    skos:prefLabel "effective"@en ;
    skos:definition "In force from its effective date. Where approval and effect differ, both dates are recorded."@en .

uiw:document-statuses--superseded
    a skos:Concept ;
    skos:inScheme uiw:document-statuses ;
    skos:topConceptOf uiw:document-statuses ;
    skos:prefLabel "superseded"@en ;
    skos:definition "Replaced by a later document; both are retained (§77)."@en .

uiw:document-statuses--withdrawn
    a skos:Concept ;
    skos:inScheme uiw:document-statuses ;
    skos:topConceptOf uiw:document-statuses ;
    skos:prefLabel "withdrawn"@en ;
    skos:definition "Removed from force without a successor; retained for the record."@en .

uiw:entity-statuses
    a skos:ConceptScheme ;
    skos:prefLabel "entity status"@en ;
    skos:definition "The status of a world-layer entity as a referent: whether the project treats it as real and distinct, provisional, invented, or disproved."@en ;
    skos:scopeNote "Fabricated and disproved entities are **preserved as referents, never deleted**: claims about them exist and remain citable (§17, §54). Impersonation analysis links a fabricated identity to the real person it imitates without merging them."@en ;
    skos:note "Status changes are assertions with evidence — concluding that a persona is fabricated is a project assertion under DR-0024, not a data-entry action."@en ;
    uiw:status "effective" ;
    uiw:effective "2026-08-16" ;
    uiw:closed "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
    uiw:steward "founder" ;
    uiw:layer "world" ;
    uiw:type "vocabulary" ;
    uiw:authorised_by "DR-0062" ;
    uiw:satisfies_requirements "DATA-002" ;
    uiw:depends_on_specs "SPEC-0002" .

uiw:entity-statuses--canonical
    a skos:Concept ;
    skos:inScheme uiw:entity-statuses ;
    skos:topConceptOf uiw:entity-statuses ;
    skos:prefLabel "canonical"@en ;
    skos:definition "An entity the project treats as a real, distinct referent."@en .

uiw:entity-statuses--candidate
    a skos:Concept ;
    skos:inScheme uiw:entity-statuses ;
    skos:topConceptOf uiw:entity-statuses ;
    skos:prefLabel "candidate"@en ;
    skos:definition "A provisionally distinct entity, not yet consolidated — e.g. a name cluster from one dataset awaiting resolution."@en .

uiw:entity-statuses--fabricated
    a skos:Concept ;
    skos:inScheme uiw:entity-statuses ;
    skos:topConceptOf uiw:entity-statuses ;
    skos:prefLabel "fabricated"@en ;
    skos:definition "An identity concluded never to have referred to a real distinct referent — an invented persona or sockpuppet identity."@en .

uiw:entity-statuses--disproved
    a skos:Concept ;
    skos:inScheme uiw:entity-statuses ;
    skos:topConceptOf uiw:entity-statuses ;
    skos:prefLabel "disproved"@en ;
    skos:definition "A formerly canonical or candidate entity shown to be a duplicate or error, superseded via merge/split lineage (DR-0064)."@en .

uiw:epistemic-categories
    a skos:ConceptScheme ;
    skos:prefLabel "epistemic category"@en ;
    skos:definition "The formal epistemic vocabulary (record §30). Every assertion in the system carries exactly one category."@en ;
    skos:note "Expansion or change only by Decision Record (DR-0025) — the record's own instruction that the vocabulary stay small and grow only when real cases require it."@en ;
    uiw:status "effective" ;
    uiw:effective "2026-08-16" ;
    uiw:closed "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
    uiw:steward "founder" ;
    uiw:layer "epistemic" ;
    uiw:type "vocabulary" ;
    uiw:authorised_by "DR-0025" ;
    uiw:satisfies_requirements "EVID-001", "EVID-002" ;
    uiw:depends_on_specs "SPEC-0001" .

uiw:epistemic-categories--observation
    a skos:Concept ;
    skos:inScheme uiw:epistemic-categories ;
    skos:topConceptOf uiw:epistemic-categories ;
    skos:prefLabel "observation"@en ;
    skos:definition "A recorded act of perceiving or measuring by a person or instrument, with observer, method, and time."@en ;
    skos:scopeNote "Subsumes both scientific-observation modelling (CRMsci S4) and the intelligence sense. Machine observations add the §49 metadata: provider, acquisition method, timestamp precision, measurement uncertainty, processing, spoofing risk. Conflict register C-12."@en ;
    skos:scopeNote "Not: A negative observation (\"we did not observe X\") is not the absence of X; see absence-states and record §48."@en .

uiw:epistemic-categories--claim
    a skos:Concept ;
    skos:inScheme uiw:epistemic-categories ;
    skos:topConceptOf uiw:epistemic-categories ;
    skos:prefLabel "claim"@en ;
    skos:definition "A proposition asserted by a source or actor, held by them, adopted into the graph with attribution."@en ;
    skos:scopeNote "\"The source says X\" — a documentary assertion (DR-0024 layer 2). Its truth is a separate question (Principle 3)."@en .

uiw:epistemic-categories--assessment
    a skos:Concept ;
    skos:inScheme uiw:epistemic-categories ;
    skos:topConceptOf uiw:epistemic-categories ;
    skos:prefLabel "assessment"@en ;
    skos:definition "An evaluative judgment about a proposition or a source, made by a named assessor on a stated basis, carrying likelihood and confidence where applicable."@en .

uiw:epistemic-categories--hypothesis
    a skos:Concept ;
    skos:inScheme uiw:epistemic-categories ;
    skos:topConceptOf uiw:epistemic-categories ;
    skos:prefLabel "hypothesis"@en ;
    skos:definition "A candidate explanation under investigation, member of a competing-hypothesis set (DR-0035)."@en ;
    skos:scopeNote "Not: Not a loose guess; a hypothesis belongs to a hypothesis set with typed evidence relations. Conflict register C-27."@en .

uiw:epistemic-categories--finding
    a skos:Concept ;
    skos:inScheme uiw:epistemic-categories ;
    skos:topConceptOf uiw:epistemic-categories ;
    skos:prefLabel "finding"@en ;
    skos:definition "A conclusion of a defined investigation or review process, recording its scope and method — including negative findings (§76)."@en ;
    skos:scopeNote "Not: Not a legal finding, which is jurisdiction- and authority-specific and always qualified as such (§62). Conflict register C-21."@en .

uiw:epistemic-categories--project-conclusion
    a skos:Concept ;
    skos:inScheme uiw:epistemic-categories ;
    skos:topConceptOf uiw:epistemic-categories ;
    skos:prefLabel "project conclusion"@en ;
    skos:definition "An editorially accountable assertion published in the project's own voice (§33), requiring human accountability (§79) and visible inference (DR-0032)."@en .

uiw:identifier-types
    a skos:ConceptScheme ;
    skos:prefLabel "identifier type"@en ;
    skos:definition "External identifier systems whose identifiers may be attached to project entities and designation records (record §16)."@en ;
    skos:note "**Open vocabulary** — new identifier systems will be encountered; additions by registry process (DR-0080). Every external identifier attaches via an **assignment assertion** with actor, time, and basis (DR-0012): identifiers are provenance-bearing relationships, not timeless fields. False merges are costlier than missed matches (§16), so identifier agreement alone does not confirm identity — see match-states."@en ;
    uiw:status "effective" ;
    uiw:effective "2026-08-16" ;
    uiw:closed "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
    uiw:steward "founder" ;
    uiw:layer "world" ;
    uiw:type "vocabulary" ;
    uiw:authorised_by "DR-0012", "DR-0045" ;
    uiw:satisfies_requirements "DATA-001", "DATA-010" ;
    uiw:depends_on_specs "SPEC-0002" .

uiw:identifier-types--wikidata
    a skos:Concept ;
    skos:inScheme uiw:identifier-types ;
    skos:topConceptOf uiw:identifier-types ;
    skos:prefLabel "Wikidata Q-identifier"@en ;
    uiw:issuingAuthority "Wikimedia Foundation" .

uiw:identifier-types--opensanctions
    a skos:Concept ;
    skos:inScheme uiw:identifier-types ;
    skos:topConceptOf uiw:identifier-types ;
    skos:prefLabel "OpenSanctions identifier"@en ;
    skos:scopeNote "Consumed as an identifier spine and collection source (DR-0045); never an auto-merge basis (§72)."@en ;
    uiw:issuingAuthority "OpenSanctions" .

uiw:identifier-types--official-sanctions-id
    a skos:Concept ;
    skos:inScheme uiw:identifier-types ;
    skos:topConceptOf uiw:identifier-types ;
    skos:prefLabel "official sanctions list identifier"@en ;
    skos:scopeNote "Attaches to designation records (DR-0039), not directly to entities."@en ;
    uiw:issuingAuthority "The designating authority (UN, EU, OFAC, OFSI, …)" .

uiw:identifier-types--company-registration-number
    a skos:Concept ;
    skos:inScheme uiw:identifier-types ;
    skos:topConceptOf uiw:identifier-types ;
    skos:prefLabel "company registration number"@en ;
    uiw:issuingAuthority "National corporate registry" .

uiw:identifier-types--tax-id
    a skos:Concept ;
    skos:inScheme uiw:identifier-types ;
    skos:topConceptOf uiw:identifier-types ;
    skos:prefLabel "tax identification number"@en ;
    skos:scopeNote "Personal tax identifiers of private individuals are high-risk data and are not structured automatically (POL-0001 §4)."@en ;
    uiw:issuingAuthority "National tax authority" .

uiw:identifier-types--lei
    a skos:Concept ;
    skos:inScheme uiw:identifier-types ;
    skos:topConceptOf uiw:identifier-types ;
    skos:prefLabel "Legal Entity Identifier (LEI)"@en ;
    uiw:issuingAuthority "GLEIF" .

uiw:identifier-types--imo
    a skos:Concept ;
    skos:inScheme uiw:identifier-types ;
    skos:topConceptOf uiw:identifier-types ;
    skos:prefLabel "IMO number"@en ;
    skos:scopeNote "Persists across vessel renaming and reflagging — a strong identifier."@en ;
    uiw:issuingAuthority "International Maritime Organization" .

uiw:identifier-types--mmsi
    a skos:Concept ;
    skos:inScheme uiw:identifier-types ;
    skos:topConceptOf uiw:identifier-types ;
    skos:prefLabel "MMSI"@en ;
    skos:scopeNote "Reassignable and spoofable; weaker than IMO. AIS-derived claims require the spoofing critical questions (DR-0034)."@en ;
    uiw:issuingAuthority "National maritime administrations" .

uiw:identifier-types--aircraft-registration
    a skos:Concept ;
    skos:inScheme uiw:identifier-types ;
    skos:topConceptOf uiw:identifier-types ;
    skos:prefLabel "aircraft registration"@en ;
    uiw:issuingAuthority "National civil aviation authority" .

uiw:identifier-types--icao-24bit
    a skos:Concept ;
    skos:inScheme uiw:identifier-types ;
    skos:topConceptOf uiw:identifier-types ;
    skos:prefLabel "ICAO 24-bit address"@en ;
    uiw:issuingAuthority "ICAO / national authorities" .

uiw:identifier-types--official-registry-id
    a skos:Concept ;
    skos:inScheme uiw:identifier-types ;
    skos:topConceptOf uiw:identifier-types ;
    skos:prefLabel "other official registry identifier"@en ;
    uiw:issuingAuthority "Varies; recorded on the assignment" .

uiw:interest-types
    a skos:ConceptScheme ;
    skos:prefLabel "interest type"@en ;
    skos:definition "The kinds of ownership or control interest one party may hold in another, recorded as typed statements with provenance and validity periods (record §19)."@en ;
    skos:scopeNote "Derived ownership computation (DR-0041) consumes these statements and preserves the path. Economic-interest calculations do not automatically establish legal control (§71)."@en ;
    skos:note "Interests are **statements with provenance**, following the BODS pattern: interested party, subject, interest type, share as a quantity object (DR-0030), validity period, and source. Registry filings, GLEIF relationship records, disclosures, and investigative findings enter as documentary sources (§32). Conflicting statements coexist under the epistemic layer — never averaged (§40)."@en ;
    skos:scopeNote "Not: \"Control\" here is corporate control — never territorial control (see territorial-statuses) and never export control. Always qualified. Conflict register C-30. \"Owner\" is never used bare; these types govern. Conflict register C-34."@en ;
    uiw:closeMatchTarget "BODS interest types" ;
    uiw:status "effective" ;
    uiw:effective "2026-08-16" ;
    uiw:closed "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
    uiw:steward "founder" ;
    uiw:layer "legal" ;
    uiw:type "vocabulary" ;
    uiw:authorised_by "DR-0040" ;
    uiw:satisfies_requirements "DATA-005", "LEGAL-004" .

uiw:interest-types--legal-ownership
    a skos:Concept ;
    skos:inScheme uiw:interest-types ;
    skos:topConceptOf uiw:interest-types ;
    skos:prefLabel "legal ownership"@en ;
    skos:definition "Registered legal title to shares or the entity."@en .

uiw:interest-types--direct-ownership
    a skos:Concept ;
    skos:inScheme uiw:interest-types ;
    skos:topConceptOf uiw:interest-types ;
    skos:prefLabel "direct ownership"@en ;
    skos:definition "Ownership held directly, without intermediate entities."@en .

uiw:interest-types--indirect-ownership
    a skos:Concept ;
    skos:inScheme uiw:interest-types ;
    skos:topConceptOf uiw:interest-types ;
    skos:prefLabel "indirect ownership"@en ;
    skos:definition "Ownership held through one or more intermediate entities."@en .

uiw:interest-types--beneficial-ownership
    a skos:Concept ;
    skos:inScheme uiw:interest-types ;
    skos:topConceptOf uiw:interest-types ;
    skos:prefLabel "beneficial ownership"@en ;
    skos:definition "Ultimate benefit from the holding, whoever holds legal title."@en .

uiw:interest-types--voting-rights
    a skos:Concept ;
    skos:inScheme uiw:interest-types ;
    skos:topConceptOf uiw:interest-types ;
    skos:prefLabel "voting rights"@en ;
    skos:definition "Rights to vote, which may diverge from economic ownership."@en .

uiw:interest-types--managerial-control
    a skos:Concept ;
    skos:inScheme uiw:interest-types ;
    skos:topConceptOf uiw:interest-types ;
    skos:prefLabel "managerial control"@en ;
    skos:definition "Control exercised through management positions."@en .

uiw:interest-types--contractual-control
    a skos:Concept ;
    skos:inScheme uiw:interest-types ;
    skos:topConceptOf uiw:interest-types ;
    skos:prefLabel "contractual control"@en ;
    skos:definition "Control arising from contractual arrangements rather than ownership."@en .

uiw:interest-types--appointment-rights
    a skos:Concept ;
    skos:inScheme uiw:interest-types ;
    skos:topConceptOf uiw:interest-types ;
    skos:prefLabel "appointment rights"@en ;
    skos:definition "Rights to appoint or remove directors or officers."@en .

uiw:interest-types--de-facto-control
    a skos:Concept ;
    skos:inScheme uiw:interest-types ;
    skos:topConceptOf uiw:interest-types ;
    skos:prefLabel "de facto control"@en ;
    skos:definition "Control exercised in practice without a formal legal basis — an evidence-backed assertion, never an inference from association."@en .

uiw:interest-types--nominee-arrangement
    a skos:Concept ;
    skos:inScheme uiw:interest-types ;
    skos:topConceptOf uiw:interest-types ;
    skos:prefLabel "nominee arrangement"@en ;
    skos:definition "Title held by one party on behalf of another."@en .

uiw:interest-types--ultimate-beneficial-ownership
    a skos:Concept ;
    skos:inScheme uiw:interest-types ;
    skos:topConceptOf uiw:interest-types ;
    skos:prefLabel "ultimate beneficial ownership"@en ;
    skos:definition "Beneficial ownership at the end of a chain, with the path preserved."@en .

uiw:likelihood-bands
    a skos:ConceptScheme ;
    skos:prefLabel "likelihood band"@en ;
    skos:definition "The calibrated verbal probability scale used to express how likely a proposition is. Seven contiguous bands spanning 1–99%, adopted from ICD 203 (US Intelligence Community analytic standards)."@en ;
    skos:scopeNote "The band identifier is stored; the numeric range is the anchor of meaning; the words are labels rendered at the presentation layer (§61). A band means the same thing in every language because the range, not the wording, carries the meaning."@en ;
    skos:scopeNote "**A band expresses the assessor's credence, not a forecast.** ICD 203's wording was built for prediction, but nearly every assessment this project makes is retrospective: a past fact either occurred or did not, and the band states how likely the evidence makes it that it did. \"Very likely that shipment X carried controlled goods in 2023\" is a claim about the analyst's uncertainty, never about the world's.\nOne scale serves both directions, because the numeric range is the anchor and probability about a determinate past fact is ordinary practice. What differs is only how the words can be misread — see the forbidden translations below. Ruled by DR-0085 (METH-0001 §15 Q5), closing DR-0065's open item."@en ;
    skos:note "A band belongs to an assessment (DR-0026) with its evidence and reasoning. Bands never attach to bare data fields, and are never inherited: reporting another body's estimative language is a documentary assertion carrying their scale (§32), mapped but never converted into a project judgment."@en ;
    skos:scopeNote "Not: Not analytic confidence (see analytic-confidence), which measures the strength of the judgment rather than the probability of the proposition. Not a statistical confidence interval. Conflict register C-18."@en ;
    uiw:exactMatchTarget "ICD 203 probability expressions" ;
    uiw:closeMatchTarget "PHIA Probability Yardstick" ;
    uiw:status "effective" ;
    uiw:effective "2026-08-16" ;
    uiw:closed "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
    uiw:steward "founder" ;
    uiw:layer "epistemic" ;
    uiw:type "vocabulary" ;
    uiw:authorised_by "DR-0026", "DR-0065" ;
    uiw:satisfies_requirements "EVID-006", "I18N-003" ;
    uiw:depends_on_specs "SPEC-0001" .

uiw:likelihood-bands--almost-no-chance
    a skos:Concept ;
    skos:inScheme uiw:likelihood-bands ;
    skos:topConceptOf uiw:likelihood-bands ;
    skos:prefLabel "almost no chance"@en ;
    skos:altLabel "remote"@en ;
    uiw:closeMatchTarget "PHIA: remote chance" ;
    uiw:range "1-5 percent" .

uiw:likelihood-bands--very-unlikely
    a skos:Concept ;
    skos:inScheme uiw:likelihood-bands ;
    skos:topConceptOf uiw:likelihood-bands ;
    skos:prefLabel "very unlikely"@en ;
    skos:altLabel "highly improbable"@en ;
    uiw:closeMatchTarget "PHIA: highly unlikely" ;
    uiw:range "5-20 percent" .

uiw:likelihood-bands--unlikely
    a skos:Concept ;
    skos:inScheme uiw:likelihood-bands ;
    skos:topConceptOf uiw:likelihood-bands ;
    skos:prefLabel "unlikely"@en ;
    skos:altLabel "improbable"@en ;
    uiw:closeMatchTarget "PHIA: unlikely" ;
    uiw:closeMatchTarget "PHIA: realistic possibility" ;
    uiw:range "20-45 percent" .

uiw:likelihood-bands--roughly-even-chance
    a skos:Concept ;
    skos:inScheme uiw:likelihood-bands ;
    skos:topConceptOf uiw:likelihood-bands ;
    skos:prefLabel "roughly even chance"@en ;
    skos:altLabel "roughly even odds"@en ;
    uiw:relatedMatchTarget "PHIA" ;
    uiw:range "45-55 percent" .

uiw:likelihood-bands--likely
    a skos:Concept ;
    skos:inScheme uiw:likelihood-bands ;
    skos:topConceptOf uiw:likelihood-bands ;
    skos:prefLabel "likely"@en ;
    skos:altLabel "probable"@en ;
    uiw:closeMatchTarget "PHIA: likely / probably" ;
    uiw:range "55-80 percent" .

uiw:likelihood-bands--very-likely
    a skos:Concept ;
    skos:inScheme uiw:likelihood-bands ;
    skos:topConceptOf uiw:likelihood-bands ;
    skos:prefLabel "very likely"@en ;
    skos:altLabel "highly probable"@en ;
    uiw:closeMatchTarget "PHIA: highly likely" ;
    uiw:range "80-95 percent" .

uiw:likelihood-bands--almost-certain
    a skos:Concept ;
    skos:inScheme uiw:likelihood-bands ;
    skos:topConceptOf uiw:likelihood-bands ;
    skos:prefLabel "almost certain"@en ;
    skos:altLabel "nearly certain"@en ;
    uiw:closeMatchTarget "PHIA: almost certain" ;
    uiw:range "95-99 percent" .

uiw:match-states
    a skos:ConceptScheme ;
    skos:prefLabel "match state"@en ;
    skos:definition "The lifecycle states of a match assertion proposing that two identity bearers refer to the same referent."@en ;
    skos:scopeNote "Applies to candidate↔canonical, designation-record↔entity (DR-0039), account↔actor (DR-0023), external-dataset↔entity, and cross-registry same-person links (DR-0059). State changes are superseding assertions (DR-0055) with actor and basis."@en ;
    skos:note "**Automated matchers and AI create `proposed` matches only** (AI-001). Human confirmation requires discriminating evidence beyond name or transliteration similarity — **name similarity alone never confirms, at any tier** (§72). Rejections are permanent and consultable so matchers do not re-propose them."@en ;
    uiw:status "effective" ;
    uiw:effective "2026-08-16" ;
    uiw:closed "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
    uiw:steward "founder" ;
    uiw:layer "world" ;
    uiw:type "vocabulary" ;
    uiw:authorised_by "DR-0063" ;
    uiw:satisfies_requirements "DATA-002", "LEGAL-003", "AI-003" ;
    uiw:depends_on_specs "SPEC-0002" .

uiw:match-states--proposed
    a skos:Concept ;
    skos:inScheme uiw:match-states ;
    skos:topConceptOf uiw:match-states ;
    skos:prefLabel "proposed"@en ;
    skos:definition "Proposed by a matcher, AI, or researcher, recording the feature basis of the proposal. Carries no canonical effect."@en .

uiw:match-states--under-review
    a skos:Concept ;
    skos:inScheme uiw:match-states ;
    skos:topConceptOf uiw:match-states ;
    skos:prefLabel "under review"@en ;
    skos:definition "Taken up for human review at the subject's tier."@en .

uiw:match-states--confirmed
    a skos:Concept ;
    skos:inScheme uiw:match-states ;
    skos:topConceptOf uiw:match-states ;
    skos:prefLabel "confirmed"@en ;
    skos:definition "Confirmed by a human on discriminating evidence at the applicable tier. Takes effect by assertion, not mutation: underlying records stay distinct."@en .

uiw:match-states--rejected
    a skos:Concept ;
    skos:inScheme uiw:match-states ;
    skos:topConceptOf uiw:match-states ;
    skos:prefLabel "rejected"@en ;
    skos:definition "Reviewed and rejected, with reason. Retained permanently and consulted by matchers."@en .

uiw:match-states--withdrawn
    a skos:Concept ;
    skos:inScheme uiw:match-states ;
    skos:topConceptOf uiw:match-states ;
    skos:prefLabel "withdrawn"@en ;
    skos:definition "Retracted by its proposer before review concluded."@en .

uiw:premis-event-types
    a skos:ConceptScheme ;
    skos:prefLabel "preservation event type"@en ;
    skos:definition "The preservation event types in the project's initial PREMIS subset. Each event carries date, agents, linked objects, outcome — **including failure** — and detail."@en ;
    skos:scopeNote "These are **pipeline events**, permanently distinct from historical world events (DR-0004). A capture is never a world event. Conflict register C-02."@en ;
    skos:note "Deferred from the initial subset with recorded revisit triggers (DR-0060): bitstream-level objects (trigger: sub-file addressing need), environments (trigger: format-migration planning at scale), preservation-level semantics."@en ;
    uiw:exactMatchTarget "PREMIS 3.0 eventType" ;
    uiw:status "effective" ;
    uiw:effective "2026-08-16" ;
    uiw:closed "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
    uiw:steward "founder" ;
    uiw:layer "pipeline" ;
    uiw:type "vocabulary" ;
    uiw:authorised_by "DR-0060" ;
    uiw:satisfies_requirements "PRES-002", "PRES-003", "PRES-007", "SEC-002" ;
    uiw:depends_on_specs "SPEC-0001", "SPEC-0003" .

uiw:premis-event-types--ingestion
    a skos:Concept ;
    skos:inScheme uiw:premis-event-types ;
    skos:topConceptOf uiw:premis-event-types ;
    skos:prefLabel "ingestion"@en ;
    skos:definition "An object entering archival custody at Gate 1 (DR-0066)."@en .

uiw:premis-event-types--message-digest-calculation
    a skos:Concept ;
    skos:inScheme uiw:premis-event-types ;
    skos:topConceptOf uiw:premis-event-types ;
    skos:prefLabel "message digest calculation"@en ;
    skos:definition "Computing content digests. SHA-512 for OCFL content addressing, SHA-256 in the fixity block (DR-0075)."@en .

uiw:premis-event-types--fixity-check
    a skos:Concept ;
    skos:inScheme uiw:premis-event-types ;
    skos:topConceptOf uiw:premis-event-types ;
    skos:prefLabel "fixity check"@en ;
    skos:definition "Verifying stored content against recorded digests. Failures are recorded events, never silent re-copies."@en .

uiw:premis-event-types--format-identification
    a skos:Concept ;
    skos:inScheme uiw:premis-event-types ;
    skos:topConceptOf uiw:premis-event-types ;
    skos:prefLabel "format identification"@en ;
    skos:definition "Determining an object's format."@en .

uiw:premis-event-types--virus-check
    a skos:Concept ;
    skos:inScheme uiw:premis-event-types ;
    skos:topConceptOf uiw:premis-event-types ;
    skos:prefLabel "virus check"@en ;
    skos:definition "Malware scanning, performed in quarantine before Gate 1 (DR-0069)."@en .

uiw:premis-event-types--capture
    a skos:Concept ;
    skos:inScheme uiw:premis-event-types ;
    skos:topConceptOf uiw:premis-event-types ;
    skos:prefLabel "capture"@en ;
    skos:definition "Acquiring content from a source, including WARC capture of web resources (DR-0006)."@en .

uiw:premis-event-types--migration-normalization
    a skos:Concept ;
    skos:inScheme uiw:premis-event-types ;
    skos:topConceptOf uiw:premis-event-types ;
    skos:prefLabel "migration / normalization"@en ;
    skos:definition "Producing a preservation-motivated derivative. The derivative is a distinct object with its own PROV lineage (DR-0003) and may live as a later version of the same OCFL object (DR-0074)."@en .

uiw:quantity-semantic-types
    a skos:ConceptScheme ;
    skos:prefLabel "quantity semantic type"@en ;
    skos:definition "The semantic type of a quantitative assertion, preserving what the source actually expressed (record §44)."@en ;
    skos:scopeNote "Aggregations must respect semantic type: a sum of at-leasts is an at-least, never an exact. \"At least 17\" must never become \"exactly 17\" (§44)."@en ;
    skos:note "Quantity objects carry the original expression (in the original language where relevant), the semantic type, value(s) and units, significant precision, stated uncertainty, and derivation method for computed values. Normalized or comparable values are derived data linked by provenance (DR-0003) and never overwrite the original expression."@en ;
    uiw:status "effective" ;
    uiw:effective "2026-08-16" ;
    uiw:closed "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
    uiw:steward "founder" ;
    uiw:layer "epistemic" ;
    uiw:type "vocabulary" ;
    uiw:authorised_by "DR-0030" ;
    uiw:satisfies_requirements "EVID-011", "DATA-005" .

uiw:quantity-semantic-types--exact
    a skos:Concept ;
    skos:inScheme uiw:quantity-semantic-types ;
    skos:topConceptOf uiw:quantity-semantic-types ;
    skos:prefLabel "exact"@en ;
    skos:definition "The source asserts a precise value."@en .

uiw:quantity-semantic-types--approximate
    a skos:Concept ;
    skos:inScheme uiw:quantity-semantic-types ;
    skos:topConceptOf uiw:quantity-semantic-types ;
    skos:prefLabel "approximate"@en ;
    skos:definition "The source asserts a value as an approximation (\"about\", \"some\")."@en .

uiw:quantity-semantic-types--at-least
    a skos:Concept ;
    skos:inScheme uiw:quantity-semantic-types ;
    skos:topConceptOf uiw:quantity-semantic-types ;
    skos:prefLabel "at least"@en ;
    skos:definition "A lower bound; the true value may be higher."@en .

uiw:quantity-semantic-types--at-most
    a skos:Concept ;
    skos:inScheme uiw:quantity-semantic-types ;
    skos:topConceptOf uiw:quantity-semantic-types ;
    skos:prefLabel "at most"@en ;
    skos:definition "An upper bound; the true value may be lower."@en .

uiw:quantity-semantic-types--range
    a skos:Concept ;
    skos:inScheme uiw:quantity-semantic-types ;
    skos:topConceptOf uiw:quantity-semantic-types ;
    skos:prefLabel "range"@en ;
    skos:definition "A bounded interval with a stated minimum and maximum."@en .

uiw:quantity-semantic-types--greater-than
    a skos:Concept ;
    skos:inScheme uiw:quantity-semantic-types ;
    skos:topConceptOf uiw:quantity-semantic-types ;
    skos:prefLabel "greater than"@en ;
    skos:definition "A strict lower bound."@en .

uiw:quantity-semantic-types--fewer-than
    a skos:Concept ;
    skos:inScheme uiw:quantity-semantic-types ;
    skos:topConceptOf uiw:quantity-semantic-types ;
    skos:prefLabel "fewer than"@en ;
    skos:definition "A strict upper bound."@en .

uiw:registration-statuses
    a skos:ConceptScheme ;
    skos:prefLabel "registration status"@en ;
    skos:definition "The registration status of a semantic-registry entry (SPEC-0004 §5)."@en ;
    skos:scopeNote "This vocabulary governs the registry's own entries, including itself."@en ;
    skos:note "**Nothing is ever deleted from the registry**: a dataset can outlive the vocabulary it used, and record §96 exists precisely so its meaning survives."@en ;
    skos:scopeNote "Not: Not document status (see document-statuses), which governs controlled documents. Conflict register C-39."@en ;
    uiw:status "effective" ;
    uiw:effective "2026-08-16" ;
    uiw:closed "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
    uiw:steward "founder" ;
    uiw:layer "governance" ;
    uiw:type "vocabulary" ;
    uiw:authorised_by "DR-0080" ;
    uiw:satisfies_requirements "DATA-008" ;
    uiw:depends_on_specs "SPEC-0004" .

uiw:registration-statuses--draft
    a skos:Concept ;
    skos:inScheme uiw:registration-statuses ;
    skos:topConceptOf uiw:registration-statuses ;
    skos:prefLabel "draft"@en ;
    skos:definition "Proposed; **may not appear in data**."@en .

uiw:registration-statuses--effective
    a skos:Concept ;
    skos:inScheme uiw:registration-statuses ;
    skos:topConceptOf uiw:registration-statuses ;
    skos:prefLabel "effective"@en ;
    skos:definition "Usable in canonical data."@en .

uiw:registration-statuses--deprecated
    a skos:Concept ;
    skos:inScheme uiw:registration-statuses ;
    skos:topConceptOf uiw:registration-statuses ;
    skos:prefLabel "deprecated"@en ;
    skos:definition "Readable in existing data; not permitted for new data. Carries `replaced_by` and a migration note (§96)."@en .

uiw:registration-statuses--retired
    a skos:Concept ;
    skos:inScheme uiw:registration-statuses ;
    skos:topConceptOf uiw:registration-statuses ;
    skos:prefLabel "retired"@en ;
    skos:definition "No longer applicable; retained for historical interpretation only."@en .

uiw:retention-tiers
    a skos:ConceptScheme ;
    skos:prefLabel "retention tier"@en ;
    skos:definition "The retention decision applied to every acquired item at Gate 1, defaulting from its source registry entry (record §9)."@en ;
    skos:scopeNote "Only `permanent` and `medium-term` items have bytes in OCFL, in **separate storage roots** so medium-term disposition can never touch the permanent archive (DR-0076)."@en ;
    skos:note "Tiers **escalate freely**; a downgrade is a governed disposition decision with recorded rationale. Fragile or high-value sources may be collected at `permanent` before item-level relevance is known, and a source's escalation may trigger retrospective recovery from external archives."@en ;
    uiw:status "effective" ;
    uiw:effective "2026-08-16" ;
    uiw:closed "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
    uiw:steward "founder" ;
    uiw:layer "pipeline" ;
    uiw:type "vocabulary" ;
    uiw:authorised_by "DR-0068" ;
    uiw:satisfies_requirements "PRES-011" ;
    uiw:depends_on_specs "SPEC-0003" .

uiw:retention-tiers--discard
    a skos:Concept ;
    skos:inScheme uiw:retention-tiers ;
    skos:topConceptOf uiw:retention-tiers ;
    skos:prefLabel "discard"@en ;
    skos:definition "Not retained. The acquisition event and its outcome are still recorded (§28) — the archive knows it saw this and let it go."@en .

uiw:retention-tiers--metadata-only
    a skos:Concept ;
    skos:inScheme uiw:retention-tiers ;
    skos:topConceptOf uiw:retention-tiers ;
    skos:prefLabel "metadata only"@en ;
    skos:definition "A descriptive record is retained; content is not stored."@en .

uiw:retention-tiers--medium-term
    a skos:Concept ;
    skos:inScheme uiw:retention-tiers ;
    skos:topConceptOf uiw:retention-tiers ;
    skos:prefLabel "medium term"@en ;
    skos:definition "Retained with a review date, then re-decided."@en .

uiw:retention-tiers--permanent
    a skos:Concept ;
    skos:inScheme uiw:retention-tiers ;
    skos:topConceptOf uiw:retention-tiers ;
    skos:prefLabel "permanent"@en ;
    skos:definition "Archival preservation under full OAIS/PREMIS treatment."@en .

uiw:review-tiers
    a skos:ConceptScheme ;
    skos:prefLabel "review tier"@en ;
    skos:definition "The risk tiers governing how much review an identity confirmation — and, by extension, other consequential decisions — requires. Record §78's risk-based review model, made concrete."@en ;
    skos:note "False merges remain costlier than missed matches at every tier (§16): when in doubt, entities stay separate and the match stays `proposed`."@en ;
    uiw:status "effective" ;
    uiw:effective "2026-08-16" ;
    uiw:closed "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
    uiw:steward "founder" ;
    uiw:layer "governance" ;
    uiw:type "vocabulary" ;
    uiw:authorised_by "DR-0063" ;
    uiw:satisfies_requirements "EDIT-001", "LEGAL-003" ;
    uiw:depends_on_specs "SPEC-0002" .

uiw:review-tiers--T1
    a skos:Concept ;
    skos:inScheme uiw:review-tiers ;
    skos:topConceptOf uiw:review-tiers ;
    skos:prefLabel "T1 — highest"@en ;
    skos:definition "Designation-record↔entity mappings and any identity used in a legal-layer conclusion (DR-0041 ownership paths, LEGAL-003)."@en .

uiw:review-tiers--T2
    a skos:Concept ;
    skos:inScheme uiw:review-tiers ;
    skos:topConceptOf uiw:review-tiers ;
    skos:prefLabel "T2 — elevated"@en ;
    skos:definition "World actors appearing in consequential project assertions; cross-registry same-person links; individual physical items in tracing chains."@en .

uiw:review-tiers--T3
    a skos:Concept ;
    skos:inScheme uiw:review-tiers ;
    skos:topConceptOf uiw:review-tiers ;
    skos:prefLabel "T3 — routine"@en ;
    skos:definition "Bibliographic identity (work/expression clustering), places with authoritative gazetteer identifiers, low-stakes dataset alignment."@en .

uiw:rights-permissions
    a skos:ConceptScheme ;
    skos:prefLabel "rights permission"@en ;
    skos:definition "What the project is permitted to do with material, recorded per rights statement (record §14)."@en ;
    skos:scopeNote "Each permission is recorded with its rights basis (copyright, license, statute, policy) per PREMIS rights (DR-0002/DR-0060)."@en ;
    skos:note "Preservation rights and republication rights are different (§14). The archive may preserve material it is not permitted to republish. `unknown` is an **explicit registry value**, never a null (DR-0029)."@en ;
    skos:scopeNote "Not: An export licence (§65) is not a rights licence. Always spelled out. Conflict register C-31."@en ;
    uiw:status "effective" ;
    uiw:effective "2026-08-16" ;
    uiw:closed "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
    uiw:steward "founder" ;
    uiw:layer "governance" ;
    uiw:type "vocabulary" ;
    uiw:authorised_by "DR-0002", "DR-0067" ;
    uiw:satisfies_requirements "LEGAL-008" .

uiw:rights-permissions--may-preserve
    a skos:Concept ;
    skos:inScheme uiw:rights-permissions ;
    skos:topConceptOf uiw:rights-permissions ;
    skos:prefLabel "may preserve"@en ;
    skos:definition "The project may hold and preserve the material."@en .

uiw:rights-permissions--may-display
    a skos:Concept ;
    skos:inScheme uiw:rights-permissions ;
    skos:topConceptOf uiw:rights-permissions ;
    skos:prefLabel "may display"@en ;
    skos:definition "The project may display the material on a public surface."@en .

uiw:rights-permissions--may-redistribute
    a skos:Concept ;
    skos:inScheme uiw:rights-permissions ;
    skos:topConceptOf uiw:rights-permissions ;
    skos:prefLabel "may redistribute"@en ;
    skos:definition "The project may redistribute the material to third parties."@en .

uiw:rights-permissions--may-provide-to-subscribers
    a skos:Concept ;
    skos:inScheme uiw:rights-permissions ;
    skos:topConceptOf uiw:rights-permissions ;
    skos:prefLabel "may provide to subscribers"@en ;
    skos:definition "The project may make the material available at the subscriber tier."@en .

uiw:rights-permissions--unknown
    a skos:Concept ;
    skos:inScheme uiw:rights-permissions ;
    skos:topConceptOf uiw:rights-permissions ;
    skos:prefLabel "unknown rights"@en ;
    skos:definition "Rights have not been determined. An explicit state requiring resolution before display or redistribution — never a default permission."@en .

uiw:scheme-coordination-attribution
    a skos:Concept ;
    skos:inScheme uiw:uiw-semantic-registry ;
    skos:prefLabel "argument from coordination to attribution"@en ;
    skos:definition "From observed coordination among actors or accounts to the claim that a common hand directs them — an operator, an organisation, a state. The scheme behind every attribution ladder (§52) and the one most exposed to §53's rule that deception attribution needs specific evidence."@en ;
    skos:note "The rung matters more than the verdict. \"These accounts are coordinated\" is a finding; \"the FSB directs them\" is a different claim several rungs up, and the archive must be able to show which rung each published statement rests on (§52, §86).\nAttribution to a state is a project conclusion in the project's own voice (DR-0024 layer 4) and is never a legal finding (§62). Where a competent authority has itself attributed, that is a documentary assertion carrying their standard of proof and is recorded as theirs."@en ;
    uiw:status "effective" ;
    uiw:effective "2026-08-26" ;
    uiw:steward "founder" ;
    uiw:layer "argument" ;
    uiw:type "argument-scheme" ;
    uiw:authorised_by "DR-0034" ;
    uiw:satisfies_requirements "EVID-012" ;
    uiw:depends_on_specs "SPEC-0001" ;
    uiw:conclusion "X directs A1…An, at the rung of the attribution ladder and the likelihood band and confidence the assessment records."@en ;
    uiw:premise "Actors or accounts A1…An exhibit coordinated behaviour B — timing, content, infrastructure, funding, targeting — beyond what independent action would produce."@en, "B, or the infrastructure behind it, bears features characteristic of actor X."@en ;
    uiw:criticalQuestion "Is the coordination real, or an artifact of how the sample was selected? Accounts found *because* they share a behaviour will share that behaviour. What is the base rate of B among accounts not selected for it?"@en, "Could B arise without direction — shared source, shared audience, platform recommendation, genuine common cause, copycat behaviour? This is the strong-prior case where METH-0001 §7 makes a hypothesis set mandatory: the project expects coordination, so it must model the alternatives it does not expect."@en, "Which rung of the attribution ladder does the evidence actually reach — coordination exists; an operator exists; the operator is identified; the operator acts for X; X directed this? Each rung is a separate claim. State the one reached and do not let the conclusion drift a rung above it (§52)."@en, "Is the signature specific to X, or shared with others — including others who imitate X? Tools, infrastructure, and stylistic tells are reused, sold, and deliberately copied. A false-flag possibility is not itself evidence of a false flag (§53), but it caps confidence until addressed."@en, "Do the lines of evidence — behavioural, technical, financial, documentary — trace to independent origins, or does one observation underwrite them all? Three analyses of one dataset are one line (DR-0028)."@en, "Does this attribution rest on earlier attributions by others? If those are premises, their own critical questions are inherited, and an attribution chain is only as strong as its weakest published link."@en, "Attribution to a named actor is consequential by definition (METH-0001 §1.5, limb 1). Has the review tier, the hypothesis set, and the review qualification the conclusion requires actually been applied — or is the argument being built to a conclusion already published?"@en .

uiw:scheme-document-authenticity
    a skos:Concept ;
    skos:inScheme uiw:uiw-semantic-registry ;
    skos:prefLabel "argument from document authenticity"@en ;
    skos:definition "From a document's features and provenance to the claim that it is what it purports to be — issued by the body named, at the date borne, in the form held."@en ;
    skos:note "**Authenticity is not veracity.** This scheme concludes only that a document is what it purports to be. An authentic document may contain falsehoods, and an established forgery may report a true event (§38, METH-0001 §3). A claim about the document's *contents* requires its own argument, and an authenticity conclusion is a premise in that argument, never a substitute for it.\nAuthenticity challenges enter the argument layer as **undermining** defeaters; challenges to what an authentic document shows enter as **undercutting** (DR-0033)."@en ;
    uiw:status "effective" ;
    uiw:effective "2026-08-26" ;
    uiw:steward "founder" ;
    uiw:layer "argument" ;
    uiw:type "argument-scheme" ;
    uiw:authorised_by "DR-0034" ;
    uiw:satisfies_requirements "EVID-012" ;
    uiw:depends_on_specs "SPEC-0001" ;
    uiw:conclusion "D is authentic — genuinely issued by the body named, at the date borne — at the likelihood band and confidence the assessment records."@en ;
    uiw:premise "Document D bears the formal features of its purported class — issuing body, register or reference number, signature or seal, layout, letterhead, classification markings, distribution list."@en, "D reached the archive by a route consistent with its purported origin, recorded as custody history (DR-0008)."@en ;
    uiw:criticalQuestion "Do the formal features match the issuing body's conventions **for that date**? Registry number formats, seal designs, letterhead and classification markings change over time; a document correct for 2024 may be wrong for 2015."@en, "Are internal references — to other documents, to persons in named posts, to organisational structures — consistent with what those were at the borne date? Anachronism is the commonest forgery tell."@en, "What do the file's own characteristics say — embedded metadata, PDF producer and revision history, fonts, scan artifacts, compression history, digital signature validity? Absence of metadata is not evidence of forgery; a scan legitimately has none (DR-0029)."@en, "Is the route by which D reached the archive documented and plausible? An anonymous leak and an official publication support very different confidences. Note the discipline: custody history is documented, but \"chain of custody\" is never claimed as a status (DR-0008, §6)."@en, "Who benefits if D is believed? A document favouring the interests of whoever supplied it warrants more scrutiny — but interest alone establishes nothing (§53: deception attribution needs specific evidence, not suspicion)."@en, "Has the purported issuer confirmed, denied, or ignored D? A denial is a documentary assertion by an interested party, not a finding — record it as such and assess it separately."@en, "Is what the archive holds the whole document, or an extract, a page, a photograph of a screen? A partial copy may be authentic and still unable to support the claim made from it (DR-0061 completeness states)."@en .

uiw:scheme-expert-opinion
    a skos:Concept ;
    skos:inScheme uiw:uiw-semantic-registry ;
    skos:prefLabel "argument from expert opinion"@en ;
    skos:definition "From an expert's judgment within their field to the proposition judged. The classic Walton scheme, which the project uses heavily — component identification, munitions analysis, forensic pathology, financial structuring, legal characterisation by others."@en ;
    skos:note "An expert's judgment enters the archive as a **documentary assertion** — what the expert said (DR-0024 layer 2). Adopting it as a project assertion is a separate act, and the project's likelihood band is its own, never inherited from the expert's estimative language (DR-0065 rule 5).\nLegal characterisation by a competent authority is **not** this scheme. Judicial findings carry jurisdiction, standard of proof and procedural posture, and are recorded as legal findings qualified as theirs (§62, METH-0001 §12)."@en ;
    uiw:status "effective" ;
    uiw:effective "2026-08-26" ;
    uiw:steward "founder" ;
    uiw:layer "argument" ;
    uiw:type "argument-scheme" ;
    uiw:authorised_by "DR-0034" ;
    uiw:satisfies_requirements "EVID-012" ;
    uiw:depends_on_specs "SPEC-0001" ;
    uiw:conclusion "P holds, at the likelihood band and confidence the assessment records."@en ;
    uiw:premise "Source S has expertise in domain D."@en, "S asserts proposition P, and P falls within D."@en ;
    uiw:criticalQuestion "What establishes S's expertise — credentials, institutional position, publication record, demonstrated track record? Expertise asserted by the source itself, or by whoever is citing them, is not established."@en, "Is P actually inside S's domain? A munitions specialist on fragmentation patterns is an expert; the same person on command responsibility is not. This is the most frequently skipped question and the most frequently decisive one."@en, "Did S give reasons, or only a conclusion? An expert judgment with visible reasoning can be assessed on its merits; one without can only be deferred to. Prefer the former and record which you have (§34)."@en, "Is P consistent with what other experts in D hold? Where experts disagree, the disagreement is the finding — record both and do not average them (§40, DR-0026)."@en, "Does S have an interest in the conclusion — employment, funding, affiliation, prior public commitment to a position? An interest raises required scrutiny; it does not make the judgment wrong (§84)."@en, "What did S actually examine? An expert reasoning from photographs, from a summary, or from another expert's report is in a materially different position from one who examined the object."@en, "Is S's judgment reported accurately, in full, and in context? Expert qualifications are the first thing lost in republication, and a hedged judgment reported flatly is a different claim (DR-0019, §58)."@en .

uiw:scheme-geolocation
    a skos:Concept ;
    skos:inScheme uiw:uiw-semantic-registry ;
    skos:prefLabel "argument from geolocation"@en ;
    skos:definition "From matched features between imagery and reference geodata to the claim that the imagery depicts a particular place."@en ;
    skos:note "A geolocation conclusion is an analyst-derived location, distinguished in the data from a source-supplied one (§46, CRMgeo's phenomenal/declarative distinction). Coordinates carry their derivation method and uncertainty as quantity objects (DR-0030)."@en ;
    uiw:status "effective" ;
    uiw:effective "2026-08-16" ;
    uiw:steward "founder" ;
    uiw:layer "argument" ;
    uiw:type "argument-scheme" ;
    uiw:authorised_by "DR-0034" ;
    uiw:satisfies_requirements "EVID-012", "DATA-007" ;
    uiw:depends_on_specs "SPEC-0001" ;
    uiw:conclusion "I depicts location L, at the precision the assessment records."@en ;
    uiw:premise "Image I contains features F1…Fn (terrain, structures, signage, shadows, vegetation, infrastructure)."@en, "Reference source R shows the same features in the same spatial relationship at location L."@en ;
    uiw:criticalQuestion "Are the matched features distinctive enough to exclude other locations, or generic (a treeline, a standard apartment block) and therefore weakly discriminating?"@en, "Is reference source R contemporaneous with the claimed date, or could construction, destruction, or seasonal change explain a mismatch — or a false match?"@en, "Is I authentic and unmanipulated, and is this its earliest known appearance? An authentic image may be attached to a false context (§38); the earliest copy held is not necessarily the original."@en, "Is the claimed **date** established independently of the location, or inherited from the post that carried the image? Location and date are separate contextual assertions (§39)."@en, "Where solar geometry is used, are shadow direction and length consistent with the claimed date, time, and latitude?"@en, "Is the stated precision warranted — exact coordinates, or an area with an uncertainty radius? Representational precision is not accuracy (§43)."@en .

uiw:scheme-image-video-verification
    a skos:Concept ;
    skos:inScheme uiw:uiw-semantic-registry ;
    skos:prefLabel "argument from image or video verification"@en ;
    skos:definition "From a visual record's features to the claim that it depicts what it is presented as depicting — the event, the place, the time, the people. Sits before geolocation, which assumes an authentic image; here that assumption is the conclusion."@en ;
    skos:note "Verification is layered: this scheme establishes that V is what it is presented as; `scheme-geolocation` then establishes where; a separate argument establishes what the depicted event *means*. Collapsing the three is how a genuine image of the wrong place becomes a false claim about the right one.\nGraphic material is preserved at its access tier and never defaults to public (PRES-012). The verification argument references the holding; it does not reproduce the image."@en ;
    uiw:status "effective" ;
    uiw:effective "2026-08-26" ;
    uiw:steward "founder" ;
    uiw:layer "argument" ;
    uiw:type "argument-scheme" ;
    uiw:authorised_by "DR-0034" ;
    uiw:satisfies_requirements "EVID-012" ;
    uiw:depends_on_specs "SPEC-0001" ;
    uiw:conclusion "V depicts E at P and T, at the likelihood band and confidence the assessment records."@en ;
    uiw:premise "Visual record V is presented as depicting event E at place P and time T."@en, "V's content, technical characteristics and provenance are consistent with that presentation."@en ;
    uiw:criticalQuestion "What is the earliest known appearance of V? Reverse search, hash comparison, and archive lookups establish whether the archive's copy is early or a re-upload. **An authentic image attached to a false context is the commonest form of visual disinformation**, and the earliest copy held is still not necessarily the original (§38, §39)."@en, "Does technical analysis show manipulation — splicing, cloning, frame insertion, synthetic generation? Error-level analysis, compression artifacts, frame-rate discontinuities, lighting inconsistency, sensor noise pattern. A clean result is not proof of authenticity; a re-encoded copy loses most of the evidence either way."@en, "Could V be wholly or partly synthetic? Generative tools now produce images and video that pass casual inspection. Detection is probabilistic and degrades with re-encoding; the question is whether the *content* is corroborated by anything that could not have been generated alongside it."@en, "Are P and T established **independently of the post that carried V**, or inherited from its caption? Place, time, and event are three separate contextual claims, each needing its own support (§39). Geolocation answers P; this question is about whether P and T were assumed or derived."@en, "Is V internally consistent — weather, season, vegetation, shadows, visible timestamps, signage, vehicle types, uniforms — with the claimed P and T?"@en, "What is outside the frame, before the first frame, after the last? An authentic, unmanipulated clip can still misrepresent by selection. A longer version or a second angle changes what V shows."@en, "Through how many hands, platforms and re-encodings has V passed before reaching the archive? Each is a derivation with its own provenance (DR-0003); metadata does not survive most of them, and its absence is not suspicious in itself (DR-0029)."@en, "Does V show identifiable people — victims, witnesses, minors, prisoners? Their appearance in an evidentiary argument is governed by POL-0001 §5 and Geneva III Art. 13 before it is a verification question at all."@en .

uiw:scheme-sign-indicator
    a skos:Concept ;
    skos:inScheme uiw:uiw-semantic-registry ;
    skos:prefLabel "argument from sign or indicator"@en ;
    skos:definition "From an observed indicator to the state of affairs it signals. The workhorse of open-source analysis — insignia to unit, shipping pattern to trade route, corporate filing to control, procurement notice to capability."@en ;
    skos:note "This scheme is where confirmation bias does most of its work: an indicator is noticed *because* it fits an expected conclusion, and the alternatives are never enumerated. `cq-alternative-causes` and `cq-base-rate` are the two that most often go unanswered, and under METH-0001 §6.2 leaving either open caps analytic confidence at `moderate`.\nChains of indicators compound rather than accumulate: three weak signs are not one strong one, and where they share an origin they are not independent at all (DR-0028, §36)."@en ;
    uiw:status "effective" ;
    uiw:effective "2026-08-26" ;
    uiw:steward "founder" ;
    uiw:layer "argument" ;
    uiw:type "argument-scheme" ;
    uiw:authorised_by "DR-0034" ;
    uiw:satisfies_requirements "EVID-012" ;
    uiw:depends_on_specs "SPEC-0001" ;
    uiw:conclusion "S obtains, at the likelihood band and confidence the assessment records."@en ;
    uiw:premise "Indicator I is observed in context C."@en, "I is associated with state of affairs S — by convention, regulation, physical necessity, or established practice."@en ;
    uiw:criticalQuestion "How strongly is I associated with S? Is the link necessary, regulated, conventional, or merely frequent? A regulated marking and an observed habit support very different confidences."@en, "What else produces I? This is the question the scheme exists for: an indicator consistent with S and with three other explanations discriminates nothing. Where alternatives are live, a hypothesis set is required (METH-0001 §7)."@en, "Is I reliably observed, or inferred from a low-resolution image, a partial record, or a third-hand description? The indicator's own evidential basis is a premise, not a given."@en, "Could I have been displayed deliberately to produce this inference? Insignia are removed and applied; flags are planted; filings are structured to be read a particular way. Note §53: attributing deception requires specific evidence, not the mere possibility of it."@en, "Does the association between I and S hold **at the time observed**? Unit markings, corporate structures, regulatory schemes and routing conventions all change; an association valid in 2018 may not be in 2025."@en, "How common is I among cases where S does *not* obtain? A distinctive indicator in a large population may still yield many false positives — the question is the rate, not the distinctiveness alone."@en, "Where the argument relies on I being **absent**, is the absence observed or merely unrecorded? \"We looked and it was not there\" and \"we have no record\" are different claims (DR-0029, METH-0001 §8)."@en .

uiw:scheme-witness-testimony
    a skos:Concept ;
    skos:inScheme uiw:uiw-semantic-registry ;
    skos:prefLabel "argument from witness testimony"@en ;
    skos:definition "From a witness's account of an event to the occurrence of that event."@en ;
    skos:note "Witness identity is held in the separable confidential store by default and is not structured into the research graph (POL-0001 §5.6, SEC-001). A scheme instance references a pseudonymous witness ID."@en ;
    uiw:status "effective" ;
    uiw:effective "2026-08-16" ;
    uiw:steward "founder" ;
    uiw:layer "argument" ;
    uiw:type "argument-scheme" ;
    uiw:authorised_by "DR-0034" ;
    uiw:satisfies_requirements "EVID-012" ;
    uiw:depends_on_specs "SPEC-0001" ;
    uiw:conclusion "E occurred, at the likelihood band and confidence the assessment records."@en ;
    uiw:premise "Witness W was in a position to observe event E."@en, "W asserts that E occurred (as recorded in a preserved source)."@en ;
    uiw:criticalQuestion "Was W actually positioned — in place, in time, with line of sight or other access — to observe E?"@en, "Was W in a condition to observe and recall accurately (visibility, duration, stress, elapsed time before recording)?"@en, "Does W have an interest, affiliation, or pressure that bears on the account? Note: bias does not make an account false; it raises the scrutiny required."@en, "Was the account given under coercion, captivity, or state supervision? Accounts from prisoners require particular care (Geneva III Art. 13; POL-0001 §5.4)."@en, "Is the account internally consistent, and consistent across retellings?"@en, "Is the account corroborated by an **independent** line? Corroboration by sources sharing this witness is not independent (DR-0028)."@en, "Is the account preserved as W gave it, or transmitted through translation, paraphrase, or edited republication? Each step is a derivation with its own provenance (DR-0003, DR-0019)."@en .

uiw:source-grades-source-reliability
    a skos:ConceptScheme ;
    skos:prefLabel "source reliability"@en ;
    skos:definition "An assessment of the source as such, independent of any particular item."@en ;
    uiw:status "effective" ;
    uiw:effective "2026-08-16" ;
    uiw:closed "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
    uiw:steward "founder" ;
    uiw:layer "epistemic" ;
    uiw:type "vocabulary" ;
    uiw:authorised_by "DR-0027" ;
    uiw:satisfies_requirements "EVID-008" ;
    uiw:axisOf uiw:source-grades .

uiw:source-grades-source-reliability--A
    a skos:Concept ;
    skos:inScheme uiw:source-grades-source-reliability ;
    skos:topConceptOf uiw:source-grades-source-reliability ;
    skos:prefLabel "completely reliable"@en .

uiw:source-grades-source-reliability--B
    a skos:Concept ;
    skos:inScheme uiw:source-grades-source-reliability ;
    skos:topConceptOf uiw:source-grades-source-reliability ;
    skos:prefLabel "usually reliable"@en .

uiw:source-grades-source-reliability--C
    a skos:Concept ;
    skos:inScheme uiw:source-grades-source-reliability ;
    skos:topConceptOf uiw:source-grades-source-reliability ;
    skos:prefLabel "fairly reliable"@en .

uiw:source-grades-source-reliability--D
    a skos:Concept ;
    skos:inScheme uiw:source-grades-source-reliability ;
    skos:topConceptOf uiw:source-grades-source-reliability ;
    skos:prefLabel "not usually reliable"@en .

uiw:source-grades-source-reliability--E
    a skos:Concept ;
    skos:inScheme uiw:source-grades-source-reliability ;
    skos:topConceptOf uiw:source-grades-source-reliability ;
    skos:prefLabel "unreliable"@en .

uiw:source-grades-source-reliability--F
    a skos:Concept ;
    skos:inScheme uiw:source-grades-source-reliability ;
    skos:topConceptOf uiw:source-grades-source-reliability ;
    skos:prefLabel "reliability cannot be judged"@en .

uiw:source-grades-item-credibility
    a skos:ConceptScheme ;
    skos:prefLabel "item credibility"@en ;
    skos:definition "An assessment of the particular item, independent of its source's general standing."@en ;
    uiw:status "effective" ;
    uiw:effective "2026-08-16" ;
    uiw:closed "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
    uiw:steward "founder" ;
    uiw:layer "epistemic" ;
    uiw:type "vocabulary" ;
    uiw:authorised_by "DR-0027" ;
    uiw:satisfies_requirements "EVID-008" ;
    uiw:axisOf uiw:source-grades .

uiw:source-grades-item-credibility--1
    a skos:Concept ;
    skos:inScheme uiw:source-grades-item-credibility ;
    skos:topConceptOf uiw:source-grades-item-credibility ;
    skos:prefLabel "confirmed by other sources"@en .

uiw:source-grades-item-credibility--2
    a skos:Concept ;
    skos:inScheme uiw:source-grades-item-credibility ;
    skos:topConceptOf uiw:source-grades-item-credibility ;
    skos:prefLabel "probably true"@en .

uiw:source-grades-item-credibility--3
    a skos:Concept ;
    skos:inScheme uiw:source-grades-item-credibility ;
    skos:topConceptOf uiw:source-grades-item-credibility ;
    skos:prefLabel "possibly true"@en .

uiw:source-grades-item-credibility--4
    a skos:Concept ;
    skos:inScheme uiw:source-grades-item-credibility ;
