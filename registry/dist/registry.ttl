uiw:source-types
    a skos:ConceptScheme ;
    skos:prefLabel "source type"@en ;
    skos:definition "The kind of source a registry entry describes, from record §8's source list."@en ;
    skos:scopeNote "Source type is descriptive and drives no automatic trust judgment. Triage grading is a separate, explicitly triage-only vocabulary (see source-grades, DR-0027)."@en ;
    skos:note "**Open vocabulary** — new source types may be added by registry process with rationale (DR-0080), since §8's list is explicitly non-exhaustive and the collection programme will encounter kinds not anticipated here."@en ;
    uiw:status "effective" ;
    uiw:effective "2026-08-16" ;
    uiw:closed "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
    uiw:steward "founder" ;
    uiw:layer "pipeline" ;
    uiw:type "vocabulary" ;
    uiw:authorised_by "DR-0067" ;
    uiw:satisfies_requirements "OPS-001" ;
    uiw:depends_on_specs "SPEC-0003" .

uiw:source-types--government
    a skos:Concept ;
    skos:inScheme uiw:source-types ;
    skos:topConceptOf uiw:source-types ;
    skos:prefLabel "government website or publication"@en ;
    skos:definition "An official organ of a state other than Russia or Ukraine, publishing in its governmental capacity."@en .

uiw:source-types--official-russian
    a skos:Concept ;
    skos:inScheme uiw:source-types ;
    skos:topConceptOf uiw:source-types ;
    skos:prefLabel "official Russian source"@en ;
    skos:definition "A Russian state body, state-controlled outlet, or official of the Russian Federation or its occupation administrations, publishing in an official capacity."@en ;
    skos:scopeNote "Typed separately from `government` because such material is simultaneously primary evidence of official position and a principal propaganda corpus (§54). The type drives collection and review defaults; it drives no truth judgment (DR-0027)."@en .

uiw:source-types--official-ukrainian
    a skos:Concept ;
    skos:inScheme uiw:source-types ;
    skos:topConceptOf uiw:source-types ;
    skos:prefLabel "official Ukrainian source"@en ;
    skos:definition "A Ukrainian state body or official publishing in an official capacity."@en ;
    skos:scopeNote "Typed separately for the same structural reason as `official-russian`: wartime official communication is a party's account, evidence of what that party stated (§32). The project is supportive of Ukrainian sovereignty and applies the same evidentiary discipline regardless (record §1)."@en .

uiw:source-types--military-security-institution
    a skos:Concept ;
    skos:inScheme uiw:source-types ;
    skos:topConceptOf uiw:source-types ;
    skos:prefLabel "military or security institution"@en ;
    skos:definition "Armed forces, intelligence services, or security agencies of any state, publishing institutionally."@en .

uiw:source-types--international-organisation
    a skos:Concept ;
    skos:inScheme uiw:source-types ;
    skos:topConceptOf uiw:source-types ;
    skos:prefLabel "international organisation"@en ;
    skos:definition "An intergovernmental body — UN organs and agencies, OSCE, ICC, Council of Europe, EU institutions in their institutional capacity."@en .

uiw:source-types--news-media
    a skos:Concept ;
    skos:inScheme uiw:source-types ;
    skos:topConceptOf uiw:source-types ;
    skos:prefLabel "news media"@en ;
    skos:definition "An outlet publishing news reporting as its principal activity."@en .

uiw:source-types--investigative-media
    a skos:Concept ;
    skos:inScheme uiw:source-types ;
    skos:topConceptOf uiw:source-types ;
    skos:prefLabel "investigative media"@en ;
    skos:definition "An outlet or collective whose principal output is original investigation rather than daily reporting."@en ;
    skos:scopeNote "Distinguished from `news-media` because such outlets typically publish underlying documents and methodology, which affects both what is worth capturing and what dependence relations to expect (DR-0028)."@en .

uiw:source-types--think-tank
    a skos:Concept ;
    skos:inScheme uiw:source-types ;
    skos:topConceptOf uiw:source-types ;
    skos:prefLabel "think tank"@en ;
    skos:definition "A research institution publishing analysis, typically with a policy orientation."@en .

uiw:source-types--ngo
    a skos:Concept ;
    skos:inScheme uiw:source-types ;
    skos:topConceptOf uiw:source-types ;
    skos:prefLabel "NGO"@en ;
    skos:definition "A non-governmental organisation publishing documentation, reporting, or advocacy — including human-rights monitors and humanitarian bodies."@en .

uiw:source-types--feed
    a skos:Concept ;
    skos:inScheme uiw:source-types ;
    skos:topConceptOf uiw:source-types ;
    skos:prefLabel "RSS/Atom feed"@en ;
    skos:definition "A syndication feed used as an acquisition channel."@en ;
    skos:scopeNote "A collection *method* rather than a kind of publisher; used where the feed is the registered entry point and the underlying publisher is recorded separately."@en .

uiw:source-types--social-media
    a skos:Concept ;
    skos:inScheme uiw:source-types ;
    skos:topConceptOf uiw:source-types ;
    skos:prefLabel "public social media"@en ;
    skos:definition "A publicly accessible account or page on a social platform other than Telegram."@en .

uiw:source-types--telegram-channel
    a skos:Concept ;
    skos:inScheme uiw:source-types ;
    skos:topConceptOf uiw:source-types ;
    skos:prefLabel "Telegram channel"@en ;
    skos:definition "A broadcast Telegram channel, where posting is restricted to operators."@en .

uiw:source-types--telegram-group
    a skos:Concept ;
    skos:inScheme uiw:source-types ;
    skos:topConceptOf uiw:source-types ;
    skos:prefLabel "public Telegram group or chat"@en ;
    skos:definition "A public Telegram group or chat in which participants post."@en ;
    skos:scopeNote "Typed separately from `telegram-channel` because participant content raises materially different personal-data exposure: group members are typically private individuals, so the more protective structuring defaults apply (POL-0001 §5.8, DR-0071)."@en .

uiw:source-types--video-platform
    a skos:Concept ;
    skos:inScheme uiw:source-types ;
    skos:topConceptOf uiw:source-types ;
    skos:prefLabel "video platform"@en ;
    skos:definition "A channel or account on a video hosting platform."@en .

uiw:source-types--podcast
    a skos:Concept ;
    skos:inScheme uiw:source-types ;
    skos:topConceptOf uiw:source-types ;
    skos:prefLabel "podcast or transcript source"@en ;
    skos:definition "An audio programme or its published transcripts."@en .

uiw:source-types--web-archive
    a skos:Concept ;
    skos:inScheme uiw:source-types ;
    skos:topConceptOf uiw:source-types ;
    skos:prefLabel "web archive"@en ;
    skos:definition "A third-party web archive from which material is retrieved."@en ;
    skos:scopeNote "Material retrieved here carries a dependence relation to the original publisher and is not an independent line (DR-0028); the archive is a custodian, not the origin (§23)."@en .

uiw:source-types--public-dataset
    a skos:Concept ;
    skos:inScheme uiw:source-types ;
    skos:topConceptOf uiw:source-types ;
    skos:prefLabel "public dataset"@en ;
    skos:definition "A structured dataset published for reuse."@en .

uiw:source-types--sanctions-authority
    a skos:Concept ;
    skos:inScheme uiw:source-types ;
    skos:topConceptOf uiw:source-types ;
    skos:prefLabel "sanctions authority or list"@en ;
    skos:definition "A designating authority and the lists it publishes (UN committees, EU, OFAC, OFSI, and national equivalents)."@en ;
    skos:scopeNote "Its published rationales are authority-attributed assertions, not project conclusions (DR-0038, DR-0039)."@en .

uiw:source-types--court-prosecutor
    a skos:Concept ;
    skos:inScheme uiw:source-types ;
    skos:topConceptOf uiw:source-types ;
    skos:prefLabel "court or prosecutor publication"@en ;
    skos:definition "A court, tribunal, or prosecuting authority publishing indictments, judgments, or case records."@en ;
    skos:scopeNote "Allegations and findings are distinguished by procedural posture, never conflated (§62–63, LEGAL-006)."@en .

uiw:source-types--corporate-registry
    a skos:Concept ;
    skos:inScheme uiw:source-types ;
    skos:topConceptOf uiw:source-types ;
    skos:prefLabel "corporate or beneficial-ownership registry"@en ;
    skos:definition "An official register of companies, directors, or beneficial ownership."@en ;
    skos:scopeNote "Registry entries are documentary assertions about the corporate record, not established facts about control (§32, DR-0040)."@en .

uiw:source-types--trade-transport-data
    a skos:Concept ;
    skos:inScheme uiw:source-types ;
    skos:topConceptOf uiw:source-types ;
    skos:prefLabel "customs"@en ;
    skos:definition "Customs records, trade statistics, vessel or aircraft tracking, and comparable movement data."@en ;
    skos:scopeNote "Declarations are documentary assertions (§67); machine-generated tracking carries the §49 metadata including spoofing risk."@en .

uiw:source-types--third-party-submission
    a skos:Concept ;
    skos:inScheme uiw:source-types ;
    skos:topConceptOf uiw:source-types ;
    skos:prefLabel "third-party submission"@en ;
    skos:definition "Material submitted to the project by an external party."@en ;
    skos:scopeNote "Enters through quarantine with submitter claims held separately from project conclusions, and confidential identity in the separable store (DR-0069, SEC-001). At-scale intake remains constrained (DR-0071)."@en .

uiw:territorial-statuses
    a skos:ConceptScheme ;
    skos:prefLabel "territorial status"@en ;
    skos:definition "Typed, evidence-backed temporal relations between actors and territorial extents, grounded in period phenomena (record §46)."@en ;
    skos:scopeNote "An occupation is a spatiotemporal phenomenon (CRM period pattern), not an attribute of a place. Geometry attaches per the place model with temporal validity (DR-0010)."@en ;
    skos:note "Each is a separate relation with its own time-span, evidence, and asserting party where it is a legal characterisation. Competing characterisations of the same territory and period **coexist** under the epistemic layer (§40) — the system does not take silent sides, and the project's own view is an explicit project assertion (§33)."@en ;
    skos:scopeNote "Not: Territorial control is never corporate control (see interest-types) or export control. Conflict register C-30."@en ;
    uiw:status "effective" ;
    uiw:effective "2026-08-16" ;
    uiw:closed "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
    uiw:steward "founder" ;
    uiw:layer "legal" ;
    uiw:type "vocabulary" ;
    uiw:authorised_by "DR-0044", "DR-0015" ;
    uiw:satisfies_requirements "DATA-007" .

uiw:territorial-statuses--sovereignty-claim
    a skos:Concept ;
    skos:inScheme uiw:territorial-statuses ;
    skos:topConceptOf uiw:territorial-statuses ;
    skos:prefLabel "sovereignty claim"@en ;
    skos:definition "An actor's assertion of sovereign title over a territory."@en .

uiw:territorial-statuses--international-recognition
    a skos:Concept ;
    skos:inScheme uiw:territorial-statuses ;
    skos:topConceptOf uiw:territorial-statuses ;
    skos:prefLabel "international recognition"@en ;
    skos:definition "Recognition of a sovereignty claim by another state or body. A recognition or non-recognition instrument (e.g. a UN General Assembly resolution) is an **authority-attributed assertion** (§62), not a project conclusion."@en .

uiw:territorial-statuses--non-recognition
    a skos:Concept ;
    skos:inScheme uiw:territorial-statuses ;
    skos:topConceptOf uiw:territorial-statuses ;
    skos:prefLabel "non-recognition"@en ;
    skos:definition "Explicit refusal to recognise a claim or a purported change of status."@en .

uiw:territorial-statuses--administration
    a skos:Concept ;
    skos:inScheme uiw:territorial-statuses ;
    skos:topConceptOf uiw:territorial-statuses ;
    skos:prefLabel "administration"@en ;
    skos:definition "The exercise of civil administrative authority over a territory."@en .

uiw:territorial-statuses--occupation
    a skos:Concept ;
    skos:inScheme uiw:territorial-statuses ;
    skos:topConceptOf uiw:territorial-statuses ;
    skos:prefLabel "occupation"@en ;
    skos:definition "Effective control of territory by a foreign armed force, as a spatiotemporal phenomenon with a time-span."@en .

uiw:territorial-statuses--de-facto-control
    a skos:Concept ;
    skos:inScheme uiw:territorial-statuses ;
    skos:topConceptOf uiw:territorial-statuses ;
    skos:prefLabel "de facto control"@en ;
    skos:definition "Actual control exercised over a territory irrespective of legal title or recognition."@en .
